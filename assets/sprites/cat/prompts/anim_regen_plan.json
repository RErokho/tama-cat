{
  "rules": [
    "No stem shared across different animations",
    "Within one anim, each index is a unique stem (no ping-pong reuse)",
    "Generate → process --use-profile → qa_anim_frames → accept or regen",
    "Reject: white/light halo, props, wrong facing, pose mismatch, big consecutive jump",
    "Color: recreate only (no RGB nudge)",
    "Canon scale/color from idle-0 after accept"
  ],
  "order": [
    "idle",
    "blink",
    "sit",
    "sleep",
    "look",
    "yawn",
    "turn",
    "alert",
    "happy",
    "annoyed",
    "stretch",
    "groom",
    "walk",
    "run",
    "jump",
    "jumpUp",
    "jumpDown",
    "land",
    "fall",
    "fallTumble",
    "fallCurl",
    "fallFlail",
    "pounce",
    "drag",
    "climb",
    "climbWindow",
    "lookDown",
    "hangDrop",
    "clingTop",
    "wallLean",
    "rub",
    "pawKeyboard",
    "bellyUp",
    "slowBlink",
    "knead",
    "attentionPaw",
    "faceHide",
    "tailChase"
  ],
  "animations": {
    "idle": {
      "fps": 3,
      "frames": [
        "idle-0",
        "idle-1",
        "idle-2",
        "idle-3"
      ],
      "desc": "Standing calm, subtle breathing/weight shift, all paws down, head level, nose RIGHT"
    },
    "blink": {
      "fps": 8,
      "frames": [
        "blink-0",
        "blink-1",
        "blink-2"
